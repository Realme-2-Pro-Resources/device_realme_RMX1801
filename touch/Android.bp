filegroup {
    name: "vendor.lineage.touch-realme-touchgesture",
    srcs: ["TouchscreenGesture.cpp"],
}

cc_library_headers {
    name: "vendor.lineage.touch-realme-headers",
    vendor_available: true,
    export_include_dirs: ["."],
}

cc_binary {
    name: "vendor.lineage.touch-service.realme_sdm660",
    init_rc: ["vendor.lineage.touch-service.realme_sdm660.rc"],
    vintf_fragments: ["vendor.lineage.touch-service.realme_sdm660.xml"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        ":vendor.lineage.touch-realme-touchgesture",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libbinder_ndk",
        "libutils",
        "vendor.lineage.touch-V1-ndk",
    ],
    header_libs: [
        "vendor.lineage.touch-realme-headers",
    ],
}
